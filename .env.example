# Keitaro Admin API
KEITARO_BASE_URL=https://your-keitaro-host
KEITARO_API_KEY=your_api_key

# Application database (SQLAlchemy)
# Local default: sqlite:///./keitaro.db
# Docker default in image: sqlite:////data/keitaro.db
DATABASE_URL=sqlite:///./keitaro.db

# Optional defaults used by API/reference helpers
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=
